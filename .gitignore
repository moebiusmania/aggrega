# Cargo build output
/target
**/*.rs.bk

# makepkg (packaging/arch) build dirs, packages and logs
/packaging/arch/src
/packaging/arch/pkg
/packaging/arch/*.pkg.tar.*
/packaging/arch/*.log

# macOS bundle output (packaging/macos/bundle.sh)
/dist

# Local-only files
CLAUDE.local.md


# Flatpak build (packaging/flatpak/build.sh): state, build dir, repo and the
# generated crate list
/.flatpak-builder
/packaging/flatpak/build
/packaging/flatpak/repo
/packaging/flatpak/cargo-sources.json
