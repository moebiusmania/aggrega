# Builds Aggrega from this local checkout (no download step).
# Usage (from this directory):  makepkg -si
pkgname=aggrega
pkgver=0.0.0
pkgrel=1
pkgdesc="Fast, lightweight, local-first RSS/Atom feed reader (Rust + Slint)"
arch=('x86_64' 'aarch64')
license=('MIT' 'OFL-1.1')
depends=(
  'gcc-libs' 'glibc'
  'fontconfig' 'freetype2'
  'libxkbcommon' 'wayland'
  'libx11' 'libxcursor' 'libxi' 'libxrandr'
  'libglvnd' 'hicolor-icon-theme'
)
optdepends=(
  'xdg-desktop-portal: file dialogs for OPML import/export'
  'zenity: file dialogs when no desktop portal is running'
)
makedepends=('cargo')
options=('!lto' '!debug')

# The project root is two levels above this PKGBUILD.
_root="$(realpath "${startdir:-.}/../..")"

# Release versions live only in Git tags (Cargo.toml keeps 0.0.0-dev), so the
# package version comes from the nearest tag: v0.9.0, or 0.9.0.r3.gabc1234
# three commits after it.
pkgver() {
  git -C "$_root" describe --tags --long --match 'v[0-9]*' 2>/dev/null \
    | sed 's/^v//;s/-\([0-9]*\)-g/.r\1.g/;s/-/./g' || echo 0.0.0
}

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  install -Dm755 "$srcdir/target/release/aggrega" "$pkgdir/usr/bin/aggrega"
  install -Dm644 "$_root/packaging/aggrega.desktop" "$pkgdir/usr/share/applications/aggrega.desktop"
  install -Dm644 "$_root/assets/aggrega.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/aggrega.svg"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_root/assets/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
